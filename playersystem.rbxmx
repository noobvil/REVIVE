		local v2 = script.Stats:Clone()

		v2.Parent = LocalPlayer.PlayerGui.MainUI
		v2.Visible = false

		local function v3(p1) --[[ addStat | Line: 14 | Upvalues: v2 (copy), v3 (copy) ]]
			local v1 = p1:GetAttribute("LayoutOrder") or 10
