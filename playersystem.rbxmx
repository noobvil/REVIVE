-- https://lua.expert/
return {
	Start = function(p1) --[[ Start | Line: 3 ]]
		local LocalPlayer = game.Players.LocalPlayer
		local Remotes = require(game.ReplicatedStorage.Modules.Remotes)
		local Camera = require(game.ReplicatedStorage.Modules.Camera)
		local CurrentLikes = game.ReplicatedStorage:WaitForChild("CurrentLikes")
		local LikeGoal = game.ReplicatedStorage:WaitForChild("LikeGoal")
		local Shop = workspace:WaitForChild("Map"):WaitForChild("Shop")
		local TipJarPrompt = Shop:WaitForChild("TipJarPrompt")
		local Coins = Shop:WaitForChild("Jar"):WaitForChild("Coins")

		repeat
			task.wait()
		until Coins.PrimaryPart

		local v1 = Coins.PrimaryPart.CFrame
		local v2 = script.JarUI:Clone()

		v2.Parent = LocalPlayer.PlayerGui

		local JarInfo = v2.JarInfo
		local ProximityPrompt = Instance.new("ProximityPrompt")

		ProximityPrompt:SetAttribute("Theme", "BuckshotFrenzy")
		ProximityPrompt.Style = Enum.ProximityPromptStyle.Custom
		ProximityPrompt.UIOffset = Vector2.new(0, 4)
		ProximityPrompt.RequiresLineOfSight = false
		ProximityPrompt.MaxActivationDistance = 10
		ProximityPrompt.ActionText = "INSPECT"
		ProximityPrompt.ObjectText = "(TIP JAR)"
		ProximityPrompt.Parent = TipJarPrompt
		ProximityPrompt.Triggered:Connect(function() --[[ Line: 35 | Upvalues: JarInfo (ref), Remotes (copy), Camera (copy), Shop (copy) ]]
			if not shared.ShopCamera then
				JarInfo.Visible = true
				Remotes:Fire("ToggleResetButton", false)
				shared.Util.HidePlayers(true)
				shared.Util.HidePrompts()
				shared.ShopCamera = Camera.New(Shop.Cameras, "TipJar", 0.4)
			end
		end)
		JarInfo.Back.MouseButton1Click:Connect(function() --[[ Line: 45 | Upvalues: JarInfo (ref), Remotes (copy) ]]
			JarInfo.Visible = false
			Remotes:Fire("ToggleResetButton", true)
			shared.Util.ShowPlayers()
			shared.Util.ShowPrompts()

			if not shared.ShopCamera then
				return
			end

			shared.ShopCamera:Destroy()
			shared.ShopCamera = nil
		end)

		local v3 = script.RequestRewardsUI:Clone()

		v3.Parent = LocalPlayer.PlayerGui
		v3.Adornee = TipJarPrompt
		v3.Enabled = false
		v3.Button.MouseButton1Click:Connect(function() --[[ Line: 59 | Upvalues: v3 (copy), Remotes (copy) ]]
			v3.Enabled = false
			Remotes:Fire("CollectLikeReward")
			shared.Sounds:Play("spend3")
		end)

		local function updateGoalStatus() --[[ updateGoalStatus | Line: 67 | Upvalues: JarInfo (ref), CurrentLikes (copy), LikeGoal (copy), Coins (copy), v1 (copy), v3 (copy) ]]
			JarInfo.Requirement.Status.Text = ("%*/%* LIKES"):format(CurrentLikes.Value, LikeGoal.Value)

			local TweenService = game.TweenService
			local v12 = TweenInfo.new(3)
			local t = {}

			t.CFrame = v1 + Vector3.new(0, CurrentLikes.Value / LikeGoal.Value * 1.25, 0)
			TweenService:Create(Coins.PrimaryPart, v12, t):Play()
			v3.Enabled = CurrentLikes.Value >= LikeGoal.Value
		end

		updateGoalStatus()
		CurrentLikes:GetPropertyChangedSignal("Value"):Connect(updateGoalStatus)
		LikeGoal:GetPropertyChangedSignal("Value"):Connect(updateGoalStatus)
	end
}]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[TipJarUI]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="BillboardGui" referent="455"><Properties><bool name="Active">true</bool><bool name="AlwaysOnTop">true</bool><float name="LightInfluence">1</float><float name="MaxDistance">25</float><UDim2 name="Size"><XS>0</XS><XO>200</XO><YS>0</YS><YO>50</YO></UDim2><bool name="Enabled">false</bool><token name="ZIndexBehavior">1</token><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[RequestRewardsUI]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="TextButton" referent="456"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/PressStart2P.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="RichText">true</bool><string name="Text"><![CDATA[CLAIM REWARD]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><Color3 name="BackgroundColor3"><R>0</R><G>0</G><B>0</B></Color3><Color3 name="BorderColor3"><R>1</R><G>1</G><B>1</B></Color3><int name="BorderSizePixel">3</int><UDim2 name="Size"><XS>0</XS><XO>200</XO><YS>0</YS><YO>50</YO></UDim2><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[Button]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="UIPadding" referent="457"><Properties><UDim name="PaddingBottom"><S>0</S><O>5</O></UDim><UDim name="PaddingLeft"><S>0</S><O>5</O></UDim><UDim name="PaddingRight"><S>0</S><O>5</O></UDim><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString