return {
	Start = function(p1) --[[ Start | Line: 3 ]]
		local LocalPlayer = game.Players.LocalPlayer

		LocalPlayer:WaitForChild("PlayerData")

		local v1 = script.Codes:Clone()

		v1.Parent = LocalPlayer.PlayerGui.MainUI
		v1.Visible = false

		local RarityInfo = require(game.ReplicatedStorage.Modules.RarityInfo)

		local function makeSkinFrame(p1) --[[ makeSkinFrame | Line: 14 | Upvalues: RarityInfo (copy) ]]
			local v1 = require(p1)
			local v2 = RarityInfo[v1.Rarity] or RarityInfo.Exclusive
			local v3 = script.SkinTemplate:Clone()

			v3.Name = p1.Name
			v3.SkinName.Text = p1.Name:upper()
			v3.SkinName.TextColor3 = v2[2]
			v3.LayoutOrder = v2[1] * 100

			local ViewportFrame = Instance.new("ViewportFrame")

			ViewportFrame.BackgroundTransparency = 1
			ViewportFrame.BackgroundColor3 = Color3.new()
			ViewportFrame.Size = UDim2.fromScale(1, 1)
			ViewportFrame.Parent = v3

			local v5 = (v1.InventorySkin or v1.Skin or v1.ItemBoxSkin):Clone()

			v5.Parent = ViewportFrame

			local Camera = Instance.new("Camera")

			Camera.CFrame = v5.PrimaryPart.CFrame * CFrame.new(0, 0, 5)
			Camera.FieldOfView = 35
			Camera.Parent = ViewportFrame
			ViewportFrame.CurrentCamera = Camera

			if v1.SkinType == "Table" then
				Camera.CFrame = v5.PrimaryPart.CFrame * CFrame.new(0, 0, 5)
				v5:SetPrimaryPartCFrame(CFrame.lookAt(v5.PrimaryPart.Position, Camera.CFrame.Position) * CFrame.new(0, 0, 17.5) * CFrame.Angles(-1.5707963267948966, 1.5707963267948966, 0))
			elseif v1.InventorySkin then
				v5:SetPrimaryPartCFrame((CFrame.lookAt(v5.PrimaryPart.Position, Camera.CFrame.Position)))
			elseif v1.ItemBoxSkin then
				local v7 = CFrame.lookAt(v5.PrimaryPart.Position + (if v1.AltView then Vector3.new(0.5, 0.125, 0) else Vector3.new()), Camera.CFrame.Position)

				if not v1.AltView then
					v7 = v7 * CFrame.Angles(0, 1.5707963267948966, 0)
				end

				v5:SetPrimaryPartCFrame(v7)
			end

			if not v1.SkinFunctionality then
				return v3
			end

			task.spawn(function() --[[ Line: 51 | Upvalues: v1 (copy), v5 (ref) ]]
				v1.SkinFunctionality(v5)
			end)

			return v3
		end

		local function showRedeemedStuff(p1) --[[ showRedeemedStuff | Line: 59 | Upvalues: LocalPlayer (copy), makeSkinFrame (copy) ]]
			local v1 = script.CodeRedeemed:Clone()

			v1.Parent = LocalPlayer.PlayerGui.TemporaryUI

			for k, v in pairs(p1) do
				if k == "Money" or k == "Chips" then
					local v2 = script.CurrencyReward:Clone()

					v2.Parent = v1.Rewards
					v2.Text = k == "Chips" and ("C$ %*"):format((shared.Util.toCommas(v))) or ("S$ %*"):format((shared.Util.toCommas(v)))

					if k == "Chips" then
						v2.TextColor3 = Color3.fromRGB(255, 110, 110)
					end

					continue
				end

				if k == "Skin" then
					local v4 = game.ReplicatedStorage.ShopItems.Skins:FindFirstChild(v, true)

					if v4 then
						makeSkinFrame(v4).Parent = v1.Rewards
					end
				end
			end

			v1.Close.MouseButton1Click:Connect(function() --[[ Line: 78 | Upvalues: v1 (copy) ]]
				v1:Destroy()
			end)
		end

		v1.CodeBox:GetPropertyChangedSignal("Text"):Connect(function() --[[ Line: 84 | Upvalues: v1 (copy) ]]
			local v12 = tostring(v1.CodeBox.Text)

			if not v12 then
				return
			end

			v1.CodeBox.Text = v12:upper()
		end)

		local v2 = false

		v1.Redeem.MouseButton1Click:Connect(function() --[[ Line: 93 | Upvalues: v2 (ref), v1 (copy), showRedeemedStuff (copy) ]]
			if v2 then
				return
			end

			v2 = true
			task.delay(0.75, function() --[[ Line: 94 | Upvalues: v2 (ref), v1 (ref) ]]
				v2 = false
				v1.Redeem.Text = "REDEEM"
			end)

			local Remotes = require(game.ReplicatedStorage.Modules.Remotes)
			local Text = v1.CodeBox.Text
			local v12 = Remotes:Fire("RedeemCode", (tostring(Text)))

			if not v12 then
				v1.Redeem.Text = "INVALID CODE"

				return
			end

			if v12 == "AlreadyRedeemed" then
				v1.Redeem.Text = "ALREADY REDEEMED"
			else
				showRedeemedStuff(v12)
			end
		end)

		local v3 = require(game.ReplicatedStorage.Modules.Icon).new()

		v3:setImage(1324431872)
		v3:setLabel("Codes")
		v3:setOrder(5)
		v3.toggled:Connect(function(p1) --[[ Line: 114 | Upvalues: v1 (copy) ]]
			v1.Visible = p1
		end)
	end
