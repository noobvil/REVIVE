-- https://lua.expert/
return {
	Start = function(p1) --[[ Start | Line: 5 ]]
		local LocalPlayer = game.Players.LocalPlayer
		local Stats = LocalPlayer:WaitForChild("PlayerData"):WaitForChild("Stats")
		local v1 = script.ConverterUI:Clone()

		v1.Parent = LocalPlayer.PlayerGui.MainUI
		v1.Visible = false
		v1.Money.Number:GetPropertyChangedSignal("Text"):Connect(function() --[[ Line: 16 | Upvalues: v1 (copy), Stats (copy) ]]
			v1.Money.Number.Text = v1.Money.Number.Text:gsub("[^%-%d]", "")

			local v12 = tonumber(v1.Money.Number.Text)

			if v12 then
				local v2 = math.clamp(v12, 0, Stats.Money.Value)

				v1.ShotChips.Display.Text = ("%*\nSHOTCHIPS"):format((math.floor(v2 * 0.0002)))
				v1.Money.Number.Text = v2
			else
				v1.ShotChips.Display.Text = "0\nSHOTCHIPS"
			end
		end)
		v1.Confirm.MouseButton1Click:Connect(function() --[[ Line: 30 | Upvalues: v1 (copy) ]]
			local Text = v1.Money.Number.Text
			local v12 = tonumber(Text)

			if v12 and v12 >= 5000 then
				v1.Money.Number.Text = ""
				v1.Confirm.Text = "CONVERTED"
				task.delay(1, function() --[[ Line: 34 | Upvalues: v1 (ref) ]]
					v1.Confirm.Text = "CONFIRM"
				end)
				require(game.ReplicatedStorage.Modules.Remotes):Fire("ConvertMoney", v12)

				return
			end

			v1.Money.Number.Text = ""

			for i = 1, 3 do
				v1.Money.Number.PlaceholderColor3 = Color3.new(255/255, 51/255, 51/255)
				task.wait(0.1)
				v1.Money.Number.PlaceholderColor3 = Color3.fromRGB(178, 178, 178)
				task.wait(0.1)
			end
		end)

		local v2 = require(game.ReplicatedStorage.Modules.Icon).new()

		v2:setImage(16951218573)
		v2:setLabel("Convert Money")
		v2:setOrder(6)
		v2.toggled:Connect(function(p1) --[[ Line: 54 | Upvalues: v1 (copy) ]]
			v1.Visible = p1
		end)
	end
}]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[MoneyConversionUI]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Frame" referent="575"><Properties><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>0</R><G>0</G><B>0</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.5</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.5</XS><XO>0</XO><YS>0.5</YS><YO>0</YO></UDim2><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[ConverterUI]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="TextLabel" referent="576"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/PressStart2P.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[CONVERT MONEY]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.11999999731779099</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.8999999761581421</XS><XO>0</XO><YS>0.20000000298023224</YS><YO>0</YO></UDim2><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[Title]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="Frame" referent="577"><Properties><Vector2 nam