return {
	Start = function(p1) --[[ Start | Line: 3 ]]
		local LocalPlayer = game.Players.LocalPlayer
		local Remotes = require(game.ReplicatedStorage.Modules.Remotes)
		local Quests = LocalPlayer:WaitForChild("PlayerData"):WaitForChild("Quests")
		local DailyQuests = Quests:WaitForChild("DailyQuests")
		local LastRefresh = Quests:WaitForChild("LastRefresh")
		local QuestBoard = workspace:WaitForChild("Map"):WaitForChild("BulletinBoards"):WaitForChild("QuestBoard")
		local SurfaceGui = QuestBoard:WaitForChild("Cork"):WaitForChild("SurfaceGui")

		SurfaceGui.Parent = LocalPlayer.PlayerGui:WaitForChild("MainUI")
		SurfaceGui.Adornee = QuestBoard.Cork

		local v1 = "Down"

		SurfaceGui:WaitForChild("ScrollButton").MouseButton1Click:Connect(function() --[[ Line: 22 | Upvalues: SurfaceGui (copy), v1 (ref) ]]
			local TweenService = game.TweenService
			local v12 = TweenInfo.new(0.25)
			local t = {}

			t.CanvasPosition = Vector2.new(0, if v1 == "Down" then 78 else 0)
			TweenService:Create(SurfaceGui.ScrollingFrame, v12, t):Play()
			v1 = if v1 == "Down" then "Up" else "Down"
			SurfaceGui.ScrollButton.Text = if v1 == "Down" then "V" else "\206\155"
		end)

		local RefreshTime = SurfaceGui:WaitForChild("RefreshTime")

		task.spawn(function() --[[ Line: 30 | Upvalues: LastRefresh (copy), RefreshTime (copy), Remotes (copy) ]]
			while task.wait(1) do
				local v2 = LastRefresh.Value + 86400 - os.time()

				if v2 < 0 then
					RefreshTime.Text = "REFRESHES SOON"
					Remotes:Fire("RequestQuestRefresh")

					continue
				end

				local v4 = string.format("%02i", (math.floor(v2 / 60 / 60)))
				local v6 = string.format("%02i", (math.floor(v2 / 60 - v4 * 60)))

				RefreshTime.Text = "REFRESHES IN " .. v4 .. ":" .. v6 .. ":" .. string.format("%02i", v2 - v6 * 60 - v4 * 60 * 60)
			end
		end)

		local function updateQuestsUI() --[[ updateQuestsUI | Line: 53 | Upvalues: SurfaceGui (copy), DailyQuests (copy) ]]
			local ScrollingFrame = SurfaceGui:WaitForChild("ScrollingFrame")

			for k, v in pairs(ScrollingFrame:GetChildren()) do
				if v.ClassName == script:WaitForChild("QuestLabel").ClassName then
					v:Destroy()
				end
			end

			for k, v in pairs(DailyQuests:GetChildren()) do
				local v1 = game.ReplicatedStorage.Modules.Quests:FindFirstChild(v.Name, true)

				if v1 then
					local v2 = script.QuestLabel:Clone()
					local v3 = require(v1)
					local Goal = v3.Goal

					if v3.PremiumReward then
						v2.Reward.Size = UDim2.fromScale(0.3, 0.5)
						v2.Reward.Position = UDim2.fromScale(1, 0.25)

						local AndLabel = v2.Reward:Clone()

						AndLabel.Parent = v2
						AndLabel.Text = "and"
						AndLabel.Name = "AndLabel"
						AndLabel.Position = UDim2.fromScale(1, 0.5)
						AndLabel.Size = UDim2.fromScale(0.3, 0.3)

						local PremiumReward = v2.Reward:Clone()

						PremiumReward.Parent = v2
						PremiumReward.Name = "PremiumReward"
						PremiumReward.Text = tonumber(v3.PremiumReward) and ("C$ %*"):format((shared.Util.toCommas(v3.PremiumReward))) or v3.PremiumReward
						PremiumReward.TextColor3 = Color3.fromRGB(255, 110, 110)
						PremiumReward.Position = UDim2.fromScale(1, 0.75)
					end

					v2.CompletedLabel.Visible = false
					v2.BarBackground.ClipsDescendants = true
					v2.QuestDescription.Text = v3.Description
					v2.LayoutOrder = tonumber(v3.Reward) or 420420420
					v2.Reward.Text = tonumber(v3.Reward) and ("S$ %*"):format((shared.Util.toCommas(v3.Reward))) or v3.Reward
					v2.Parent = ScrollingFrame

					local Scale = v2.BarBackground.Clipping.Size.X.Scale

					local function updateBar() --[[ updateBar | Line: 97 | Upvalues: v2 (copy), v (copy), Goal (copy), Scale (copy) ]]
						if not v2.Parent then
							return
						end

						local v22 = math.clamp(v.Value / Goal, 0, 1) * Scale

						v2.BarBackground.BarProgress.Text = math.clamp(math.floor(v.Value), 0, Goal) .. "/" .. Goal
						v2.BarBackground.Clipping:TweenSize(UDim2.new(v22, 0, v2.BarBackground.Clipping.Size.Y.Scale, 0), "InOut", "Linear", 0.2, true)
						v2.BarBackground.Clipping.Bar:TweenSize(UDim2.new(Scale / v22, 0, 1, 0), "InOut", "Linear", 0.2, true)

						if not (Goal <= v.Value) then
							return
						end

						v2.CompletedLabel.Visible = true
					end

					updateBar()
					v:GetPropertyChangedSignal("Value"):Connect(updateBar)
				end
			end
		end

		updateQuestsUI()
		DailyQuests.ChildAdded:Connect(updateQuestsUI)
		SurfaceGui:WaitForChild("RefreshNow").MouseButton1Click:Connect(function() --[[ Line: 119 | Upvalues: LocalPlayer (copy) ]]
			game:GetService("MarketplaceService"):PromptProductPurchase(LocalPlayer, 1788003784)
		end)
