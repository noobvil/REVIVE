return {
	DevLocked = true,
	LoadCommand = function(p1, p2) --[[ LoadCommand | Line: 5 ]]
		local Remotes = require(game.ReplicatedStorage.Modules.Remotes)
		local v1 = script.GiveMoney:Clone()

		v1.Parent = p2.Commands
		v1.LayoutOrder = 5
		v1.TextBox.FocusLost:Connect(function(p1) --[[ Line: 11 | Upvalues: v1 (copy), Remotes (copy) ]]
			if not p1 then
				return
			end

			local v12 = tonumber(v1.TextBox.Text)

			if v12 then
				Remotes:Fire("ModCommandUsed", "GiveMoney", v12)

				return
			end

			for i = 1, 3 do
				v1.TextBox.Text = ""
				v1.TextBox.PlaceholderColor3 = Color3.new(255/255, 51/255, 51/255)
				task.wait(0.1)
				v1.TextBox.PlaceholderColor3 = Color3.new(255/255, 255/255, 255/255)
				task.wait(0.1)
			end
		end)

		local v2 = script.GiveMoney:Clone()

		v2.CommandDescription.Text = "GIVE YOURSELF SHOTCHIPS"
		v2.CommandDescription.TextColor3 = Color3.fromRGB(255, 75, 90)
		v2.TextBox.PlaceholderText = "AMT OF CHIPS"
		v2.Parent = p2.Commands
		v2.LayoutOrder = 6
		v2.TextBox.FocusLost:Connect(function(p1) --[[ Line: 38 | Upvalues: v2 (copy), Remotes (copy) ]]
			if not p1 then
				return
			end

			local v1 = tonumber(v2.TextBox.Text)

			if v1 then
				Remotes:Fire("ModCommandUsed", "GiveMoney", v1, true)

				return
			end

			for i = 1, 3 do
				v2.TextBox.Text = ""
				v2.TextBox.PlaceholderColor3 = Color3.new(255/255, 51/255, 51/255)
				task.wait(0.1)
				v2.TextBox.PlaceholderColor3 = Color3.fromRGB(255, 75, 90)
				task.wait(0.1)
			end
