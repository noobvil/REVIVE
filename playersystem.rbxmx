			end

			table.insert(t, p1)
		end

		local function fixLighting() --[[ fixLighting | Line: 15 | Upvalues: t (copy) ]]
			for k, v in pairs(t) do
				local SavedQualityLevel = UserSettings().GameSettings.SavedQualityLevel.Value

				if SavedQualityLevel <= 3 and not v:GetAttribute("LowQuality") then
					v:SetAttribute("LowQuality", true)
					v.Brightness = v.Brightness * 2.6

					continue
				end

				if SavedQualityLevel > 3 and v:GetAttribute("LowQuality") then
					v:SetAttribute("LowQuality", nil)
					v.Brightness = v.Brightness / 2.6
				end
			end
		end

		for k, v in pairs(workspace:GetDescendants()) do
			if v.Name == "GraphicsAffectedLight" then
				table.insert(t, v)
			end
		end

		workspace.DescendantAdded:Connect(addLight)
		UserSettings().GameSettings.Changed:Connect(function() --[[ Line: 33 | Upvalues: fixLighting (copy) ]]
			fixLighting()
		end)
		fixLighting()
	end
}]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[GraphicsLevelLightingFix]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="227"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

