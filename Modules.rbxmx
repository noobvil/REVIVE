-- https://lua.expert/
local t = {}

t.__index = t
function t.New(p1, p2, p3) --[[ New | Line: 4 | Upvalues: t (copy) ]]
	if p1 == "Shotgun" then
		if not p2.Skin then
			warn((("No skin found in %*. Make sure one exists under the skin module!"):format((tostring(p1)))))

			return
		end

		if not p2.Skin:FindFirstChild("Base") then
			warn((("No base found in %*. Make sure one exists under the skin model!"):format((tostring(p1)))))

			return
		end

		if not p2.Skin.Base:FindFirstChild("Center") then
			warn((("No center part for the base found in %*. Make sure one exists under the skin model!"):format((tostring(p1)))))

			return
		end
	elseif p1 == "Table" then
		if not p2.Skin then
			warn((("No skin found in %*. Make sure one exists under the skin module!"):format((tostring(p1)))))

			return
		end
	else
		if not p2.ItemBoxSkin then
			warn((("No item skin for the item box found in %*. Make sure one exists under the skin module!"):format((tostring(p1)))))

			return
		end

		if not p2.RigSkin then
			warn((("No item skin for the rig found in %*. Make sure one exists under the skin module!"):format((tostring(p1)))))

			return
		end
	end

	local t2 = {
		Type = p1,
		PlayerModelSkins = {},
		OriginalModelInfo = {}
	}

	setmetatable(t2, t)

	local function hideParts(p1, p2) --[[ hideParts | Line: 25 | Upvalues: t2 (copy) ]]
		for k, v in pairs(p1:GetDescendants()) do
			if v:IsA("BasePart") then
				if not p2 then
					t2.OriginalModelInfo[v] = v.Transparency
				end

				v:SetAttribute("OriginalTransparency", 1)
				v.Transparency = 1
			end
		end
	end

	if p1 == "Shotgun" then
		t2.Skin = p2.Skin:Clone()

		local Shotgun = shared.Game.Map.Shotgun

		hideParts(Shotgun)
		t2.Skin.PrimaryPart = t2.Skin.Base.Center
		t2.Skin.Name = "Skin"
		t2.Skin:SetPrimaryPartCFrame(Shotgun.PrimaryPart.CFrame)
		t2.Skin.Parent = Shotgun

		for k, v in pairs(t2.Skin:GetDescendants()) do
			if v:IsA("BasePart") then
				local WeldConstraint = Instance.new("WeldConstraint")

				WeldConstraint.Parent = v
				WeldConstraint.Part0 = Shotgun.PrimaryPart
				WeldConstraint.Part1 = v
				v.CanCollide = false
				v.CanQuery = false
			end
		end

		if p2.SkinFunctionality then
			task.spawn(function() --[[ Line: 60 | Upvalues: p2 (copy), t2 (copy) ]]
				p2.SkinFunctionality(t2.Skin)
			end)
		end

		task.delay(2, function() --[[ Line: 66 | Upvalues: hideParts (copy), t2 (copy), p2 (copy) ]]
			for k, v in pairs(shared.Game.Map.PlayerModels:GetChildren()) do
				local ShotgunRig = v:WaitForChild("Items"):WaitForChild("ShotgunRig")

				hideParts(ShotgunRig, true)

				repeat
