			shared.Game["CarefulNow" .. v.Name] = true
			shared.Dialog.CreateDialog({ "CAREFUL, NOW." })
		end
	end

	task.wait(0.6)
	shared.Game.Camera:SetCamera(if v2 then "LookingAtBoard" else "LookingAtDealer")
end

