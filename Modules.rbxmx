-- https://lua.expert/
local t = {}

t.__index = t
function t.New() --[[ New | Line: 4 | Upvalues: t (copy) ]]
	local t2 = {}

	setmetatable(t2, t)
	t2.UI = script.LivesUI:Clone()
	t2.UI.Parent = shared.Game.Map.Table.LivesDisplay.LivesDisplayScreen

	return t2
end
function t.Destroy(p1) --[[ Destroy | Line: 14 ]]
	if not p1.UI then
		return
	end

	p1.UI:Destroy()
end
function t.StartRound(p1, p2) --[[ StartRound | Line: 19 ]]
	shared.Game.Camera:SetCamera("Lives")
	task.wait(0.5)
end
function t.SetLives(p1, p2, p3) --[[ SetLives | Line: 25 ]]
	if game["Run Service"]:IsServer() then
		for k, v in pairs(p2.Lives:GetChildren()) do
			v.Value = p3
		end
	else
		if not shared.Game.Spectating then
			shared.Game.Camera:SetCamera("Lives")
			task.wait(0.525)
		end

		for k, v in pairs(shared.Game.Map.Players:GetChildren()) do
			local v2 = p1.UI.RoundInfo[(if k == 1 then "Player" else "Dealer") .. "Name"]

			v2.Text = string.sub(v:GetAttribute("Name") or v.Name, 1, 6)

			local v4 = game.Players:FindFirstChild(v.Name)

			if v4 then
				local v5 = v4:FindFirstChild("PlayerData") and (v4.PlayerData:FindFirstChild("Settings") and (v4.PlayerData.Settings:FindFirstChild("PlayerName") and v4.PlayerData.Settings.PlayerName.Value))

				if v5 then
					v2.Text = v5
				end
			end
		end

		p1.UI.RoundInfo.Visible = true

		if not shared.Game.Spectating then
			if shared.Game.Config.Modifier and shared.Game.Config.Modifier.HideLives then
				p1.UI.TextDisplay.Visible = true
			end

			shared.Sounds:Play("life_display_turned_on", {
				Parent = shared.Game.Map.Table.LivesDisplay.LivesDisplayScreen
			})
